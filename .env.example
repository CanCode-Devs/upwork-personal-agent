# Dashboard login — optional. First visit creates the owner admin in the browser.
# Extra operators are created in the Users page, not here.
# Leave DASHBOARD_PASSWORD as change-me to use the setup page instead of auto-creating admin.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# Optional. If unset or left as the example value, the app writes a random secret to ./data/session_secret
SESSION_SECRET=replace-with-a-long-random-string

# Optional overrides. Prefer Config in the dashboard (secrets are write-only there).
# Values here seed Config on first boot and remain a fallback if a key is not saved in the UI.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Cover letters, screening answers, milestones (job page Write / Regenerate)
OPENAI_DRAFT_MODEL=gpt-4o

# Product label in the dashboard, FastAPI title, and OAuth client name.
# Studio branding (CanCode Devs) is built in and not set here.
APP_NAME=Upwork Personal Agent
APP_TAGLINE=Adaptive agent

# Copy profiles/example.yaml onto PROFILE_PATH if that file is missing
PROFILE_PATH=./profiles/default.yaml

# Optional scoring overrides. Copy profiles/scoring.example.yaml to scoring.yaml
# SCORING_PATH=./profiles/scoring.yaml

# Seed owner case studies into Portfolio. Leave false for a clean clone.
SEED_DEMO_PORTFOLIO=false

# Used only when the profile YAML has no search_queries
SEARCH_QUERIES=python fastapi,next.js typescript

# Seeded into SQLite on first boot; after that Settings (Preferences) owns these floors
MIN_SCORE=70
AUTONOMY_MODE=manual
AUTO_SUBMIT_THRESHOLD=85
MIN_HOURLY=
MIN_FIXED=

# Seeded into Config on first boot; after that the Config page owns these
POLL_INTERVAL_MINUTES=15
APPROVAL_TTL_HOURS=24
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
UPWORK_MCP_URL=https://mcp.upwork.com/mcp

BIND_HOST=127.0.0.1
BIND_PORT=8000
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

OAUTH_REDIRECT_PORT=8765
# Host the browser uses for the OAuth redirect (usually 127.0.0.1)
OAUTH_REDIRECT_HOST=127.0.0.1
HF_HOME=/models/huggingface
